{
  "scenarios": [
    {
      "name": "opening a thread, reacting and replying all work, and a half-written reply survives a reaction",
      "members": {
        "viewer": "adult",
        "other": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forum__threads (id, title, body, author_id, author_name, pinned, created_at, updated_at, visibility) VALUES (?, ?, ?, ?, ?, 0, ?, ?, 'everyone')",
          "params": [
            "ui-t1",
            "Garden day",
            "Who is in for Saturday?",
            "{{other}}",
            "Other",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forum__replies (id, thread_id, body, author_id, author_name, created_at) VALUES (?, ?, ?, ?, ?, ?)",
          "params": [
            "ui-r1",
            "ui-t1",
            "Count me in",
            "{{other}}",
            "Other",
            "2026-01-01T00:00:00Z"
          ]
        },
        {
          "action": "open",
          "as": "viewer"
        },
        {
          "action": "expectText",
          "as": "viewer",
          "selector": ".thread-card[data-id=\"ui-t1\"]",
          "text": "Garden day"
        },
        {
          "action": "click",
          "as": "viewer",
          "selector": ".thread-card[data-id=\"ui-t1\"] .thread-title"
        },
        {
          "action": "expectText",
          "as": "viewer",
          "selector": ".thread-detail-title",
          "text": "Garden day"
        },
        {
          "action": "expectCount",
          "as": "viewer",
          "selector": ".reply-card",
          "count": 1
        },
        {
          "action": "fill",
          "as": "viewer",
          "selector": "#reply-body",
          "value": "Bringing a wheelbarrow"
        },
        {
          "action": "click",
          "as": "viewer",
          "selector": ".thread-detail-header .reaction-add"
        },
        {
          "action": "expectVisible",
          "as": "viewer",
          "selector": ".thread-detail-header .emoji-picker"
        },
        {
          "action": "click",
          "as": "viewer",
          "selector": ".thread-detail-header .emoji-picker .emoji-opt[data-emoji]:first-child"
        },
        {
          "action": "expectCount",
          "as": "viewer",
          "selector": ".thread-detail-header .reaction-btn.reacted",
          "count": 1
        },
        {
          "action": "expectText",
          "as": "viewer",
          "selector": "#reply-body",
          "text": "Bringing a wheelbarrow"
        },
        {
          "action": "click",
          "as": "viewer",
          "selector": ".reply-form .btn-primary"
        },
        {
          "action": "expectCount",
          "as": "viewer",
          "selector": ".reply-card",
          "count": 2
        },
        {
          "action": "reload",
          "as": "viewer"
        },
        {
          "action": "expectText",
          "as": "viewer",
          "selector": ".thread-card[data-id=\"ui-t1\"]",
          "text": "2 replies"
        },
        {
          "action": "expectText",
          "as": "viewer",
          "selector": ".thread-card[data-id=\"ui-t1\"]",
          "text": "1 reaction"
        }
      ]
    },
    {
      "name": "pinning from the list pins without opening the thread, and a child is offered no pin",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forum__threads (id, title, body, author_id, author_name, pinned, created_at, updated_at, visibility) VALUES (?, ?, ?, ?, ?, 0, ?, ?, 'everyone')",
          "params": [
            "ui-t2",
            "House rules",
            "Shoes off",
            "{{kid}}",
            "Kid",
            "2026-01-01T00:00:00Z",
            "2026-01-01T00:00:00Z"
          ]
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": ".thread-card[data-id=\"ui-t2\"]"
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-action=\"pin\"]",
          "count": 0
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": ".thread-card[data-id=\"ui-t2\"] [data-action=\"pin\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": ".thread-card[data-id=\"ui-t2\"] .pin-icon"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": ".thread-detail-title",
          "count": 0
        },
        {
          "action": "reload",
          "as": "parent"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": ".thread-card[data-id=\"ui-t2\"] .pin-icon"
        }
      ]
    },
    {
      "name": "in a shared space a participant is offered pin and delete only on their own thread and delete only on their own reply; the steward is offered them on everyone's",
      "context": "shared_space",
      "members": {
        "steward": "admin",
        "pat": "adult",
        "sam": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forum__threads (id, title, body, author_id, author_name, pinned, reply_count, created_at, updated_at, visibility) VALUES (?, ?, ?, ?, ?, 0, ?, ?, ?, 'everyone')",
          "params": [
            "sp-t-sam",
            "Spring cleanup",
            "Which weekend suits everyone?",
            "{{sam}}",
            "Sam",
            2,
            "2026-01-02T00:00:00Z",
            "2026-01-02T00:00:00Z"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forum__threads (id, title, body, author_id, author_name, pinned, reply_count, created_at, updated_at, visibility) VALUES (?, ?, ?, ?, ?, 0, ?, ?, ?, 'everyone')",
          "params": [
            "sp-t-pat",
            "Tool library",
            "I can lend a ladder.",
            "{{pat}}",
            "Pat",
            0,
            "2026-01-03T00:00:00Z",
            "2026-01-03T00:00:00Z"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forum__replies (id, thread_id, body, author_id, author_name, created_at) VALUES (?, ?, ?, ?, ?, ?)",
          "params": [
            "sp-r-sam",
            "sp-t-sam",
            "The second one works for me.",
            "{{sam}}",
            "Sam",
            "2026-01-04T00:00:00Z"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forum__replies (id, thread_id, body, author_id, author_name, created_at) VALUES (?, ?, ?, ?, ?, ?)",
          "params": [
            "sp-r-pat",
            "sp-t-sam",
            "Either is fine.",
            "{{pat}}",
            "Pat",
            "2026-01-05T00:00:00Z"
          ]
        },
        {
          "action": "open",
          "as": "pat"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"thread-card\"][data-thread-id=\"sp-t-sam\"]"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"thread-pin\"][data-thread-id=\"sp-t-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"thread-pin\"]",
          "count": 1
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"thread-delete\"]",
          "count": 1
        },
        {
          "action": "click",
          "as": "pat",
          "selector": "[data-testid=\"thread-title\"][data-thread-id=\"sp-t-sam\"]"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"thread-detail\"][data-thread-id=\"sp-t-sam\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"reply-card\"]",
          "count": 2
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"thread-detail-pin\"]",
          "count": 0
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"thread-detail-delete\"]",
          "count": 0
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"reply-delete\"][data-reply-id=\"sp-r-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"reply-delete\"]",
          "count": 1
        },
        {
          "action": "open",
          "as": "steward"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"thread-card\"][data-thread-id=\"sp-t-sam\"]"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"thread-pin\"][data-thread-id=\"sp-t-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"thread-pin\"]",
          "count": 2
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"thread-delete\"]",
          "count": 2
        },
        {
          "action": "click",
          "as": "steward",
          "selector": "[data-testid=\"thread-title\"][data-thread-id=\"sp-t-sam\"]"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"thread-detail\"][data-thread-id=\"sp-t-sam\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"reply-card\"]",
          "count": 2
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"thread-detail-pin\"]"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"thread-detail-delete\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"reply-delete\"]",
          "count": 2
