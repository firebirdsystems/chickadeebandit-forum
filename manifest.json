{
  "id": "forum",
  "name": "Forum",
  "version": "1.0.0",
  "description": "Threaded discussions — post topics, reply with markdown, react with emoji. Admins manage categories; adults can pin and moderate.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "preload": {
    "categories": {"sql": "SELECT * FROM app_forum__categories ORDER BY position"}
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, created_at AS at FROM app_forum__threads ORDER BY created_at DESC LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "when": "at"
    }
  },
  "db_plaintext_columns": ["color", "reply_count", "reaction_count"],
  "row_policies": {
    "categories": {
      "kind": "adult_writable"
    },
    "threads": {
      "kind": "owner_or_visibility",
      "member_column": "author_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "column_write_acls": {
        "reply_count": { "writable_by": [] },
        "reaction_count": { "writable_by": [] }
      },
      "retain_days": {
        "default": 90,
        "timestamp_column": "created_at",
        "exempt_when": { "column": "pinned", "values": [1] },
        "dependent_tables": [
          {
            "table": "replies",
            "foreign_key": "thread_id",
            "id_column": "id",
            "dependent_tables": [
              { "table": "reactions", "foreign_key": "target_id" }
            ]
          },
          { "table": "reactions", "foreign_key": "target_id" }
        ]
      }
    },
    "replies": {
      "kind": "inherit_visibility",
      "parent_table": "threads",
      "fk_column": "thread_id",
      "writer_column": "author_id"
    },
    "reactions": {
      "kind": "owner_or_visibility",
      "member_column": "author_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true,
      "max_per_member": {
        "member_column": "author_id",
        "scope_columns": ["target_id", "emoji"],
        "limit": 1
      }
    },
    "forum_settings": {
      "kind": "adult_writable"
    }
  },
  "write_effects": {
    "replies": {
      "insert": [
        {
          "label": "reply_count",
          "statement": "UPDATE app_forum__threads SET reply_count = (SELECT COUNT(*) FROM app_forum__replies r WHERE r.thread_id = app_forum__threads.id) WHERE id = :new.thread_id"
        }
      ],
      "delete": [
        {
          "label": "reply_count",
          "bind": "thread_id",
          "statement": "UPDATE app_forum__threads SET reply_count = (SELECT COUNT(*) FROM app_forum__replies r WHERE r.thread_id = app_forum__threads.id) WHERE id IN :affected"
        }
      ]
    },
    "reactions": {
      "insert": [
        {
          "label": "reaction_count",
          "statement": "UPDATE app_forum__threads SET reaction_count = (SELECT COUNT(*) FROM app_forum__reactions x WHERE x.target_id = app_forum__threads.id) WHERE id = :new.target_id"
        }
      ],
      "delete": [
        {
          "label": "reaction_count",
          "bind": "target_id",
          "statement": "UPDATE app_forum__threads SET reaction_count = (SELECT COUNT(*) FROM app_forum__reactions x WHERE x.target_id = app_forum__threads.id) WHERE id IN :affected"
        }
      ]
    }
  },
  "member_references": {
    "threads": { "column": "author_id", "on_removed": "keep" },
    "replies": { "column": "author_id", "on_removed": "keep" },
    "reactions": { "column": "author_id", "on_removed": "delete" }
  },
  "category": "general",
  "tags": [
    "forum",
    "discussion",
    "threads",
    "markdown"
  ],
  "publishes": [
    "forum.post.created"
  ],
  "alert_on": [
    "forum.post.created"
  ],
  "nav": {
    "label": "Forum"
  },
  "widget": {
    "label": "Forum",
    "size": "medium"
  },
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "resource_limits": {
    "max_db_bytes": 10485760,
    "max_store_reads_per_day": 2000,
    "max_store_writes_per_day": 500
  },
  "icon": "💬"
}
